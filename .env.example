# Neon PostgreSQL Database (use a development/test branch locally)
DATABASE_URL=postgresql://example_user:example_password@database.example.invalid:5432/example_database
DATABASE_ENV=development
ALLOW_DESTRUCTIVE_DB_OPERATION=false
ALLOW_DATABASE_MIGRATION=false

# JWT Session Auth
JWT_SECRET=your-super-secret-jwt-key

# MSG91 Phone OTP Service
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-otp-template-id

# Razorpay Payments
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# AWS Video Pipeline (S3, CloudFront)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_RAW_BUCKET=airbharath-lms-raw-uploads
AWS_S3_PROCESSED_BUCKET=airbharath-lms-processed-videos
AWS_CLOUDFRONT_DOMAIN=d3ki7wjrtdq31t.cloudfront.net
AWS_CLOUDFRONT_KEY_PAIR_ID=K1234567890ABC
AWS_CLOUDFRONT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Upstash Redis (Session Limits)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Mailercloud Transactional Email Service
MAILERCLOUD_API_KEY=your-mailercloud-api-key
MAILERCLOUD_SENDER_EMAIL=notifications@airbharath.in
MAILERCLOUD_SENDER_NAME=Airbharath LMS

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=your-posthog-host
# Cloud host: https://us.i.posthog.com or https://eu.i.posthog.com.
# Browser events use /api/telemetry; server events use the configured cloud host.
# Local live analytics requires explicit opt-in (restart the dev server after changing).
NEXT_PUBLIC_POSTHOG_ENABLE_DEV=false

# Next.js App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development

# Workspace financial domain — independent from legacy LMS Razorpay settings.
# Keep all capabilities OFF by default. Never put Live credentials in local/Preview env.
WORKSPACE_RAZORPAY_KEY_ID=
WORKSPACE_RAZORPAY_KEY_SECRET=
WORKSPACE_RAZORPAY_WEBHOOK_SECRET=
WORKSPACE_RAZORPAY_ACCOUNT_ID=
WORKSPACE_RAZORPAY_MODE=test
WORKSPACE_RAZORPAY_TEST_AUTHORIZED=false
WORKSPACE_RAZORPAY_LIVE_AUTHORIZED=false
WORKSPACE_PAYMENT_ENABLED=false
WORKSPACE_REFUND_ENABLED=false
WORKSPACE_RAZORPAY_WEBHOOK_ENABLED=false
WORKSPACE_RAZORPAY_RECONCILIATION_ENABLED=false
# Vercel sends this as Authorization: Bearer; >=32 characters. No schedule configured here.
CRON_SECRET=

# Durable Workspace refund notifications: source/config readiness is NOT delivery verification.
# Existing MAILERCLOUD_API_KEY / MAILERCLOUD_SENDER_EMAIL / MAILERCLOUD_SENDER_NAME are server-only.
# NEXT_PUBLIC_BASE_URL must be an explicitly configured, validated origin.
WORKSPACE_NOTICE_DELIVERY_ENABLED=false
WORKSPACE_NOTICE_SENDER_VERIFIED=false
# Non-secret operator label identifying the intended Mailercloud account/configuration.
WORKSPACE_NOTICE_PROVIDER_SCOPE=
