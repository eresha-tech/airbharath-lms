{
  "CORSRules": [
    {
      "AllowedOrigins": [
        "http://localhost:3000"
      ],
      "AllowedMethods": [
        "PUT"
      ],
      "AllowedHeaders": [
        "content-type",
        "if-none-match",
        "x-amz-server-side-encryption",
        "x-amz-expected-bucket-owner",
        "x-amz-checksum-sha256",
        "x-amz-meta-workspace-*"
      ],
      "ExposeHeaders": [
        "ETag",
        "x-amz-version-id",
        "x-amz-checksum-sha256"
      ],
      "MaxAgeSeconds": 300
    }
  ]
}
